PERSONAL_CONTEXT_KEY_FILE=/private/runtime/archive.key
# Shared ChatGPT sign-in is owned by the unified enrichment layer.
PERSONAL_CONTEXT_VOICE_SUMMARIES_ENABLED=0
PERSONAL_CONTEXT_ENRICHMENT_DIR=/private/runtime/enrichment
# Optional local CPU vectors; no OpenAI embeddings/API charges.
PERSONAL_CONTEXT_VOICE_EMBED_MODEL=fastembed:BAAI/bge-small-en-v1.5
PERSONAL_CONTEXT_VOICE_MODEL_DIR=/private/runtime/voice-models
PERSONAL_CONTEXT_VOICE_WHISPER_MODEL=base
PERSONAL_CONTEXT_VOICE_TMPDIR=/dev/shm
