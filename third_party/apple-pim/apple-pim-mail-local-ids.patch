+struct ExportMessages: AsyncParsableCommand {
+    static let configuration = CommandConfiguration(
+        commandName: "export",
+        abstract: "Stream exact read-only mailbox copies as newline-delimited JSON"
+    )
+
+    @OptionGroup var pimOptions: PIMOptions
+
+    @Option(name: .long, help: "Exact local mailbox row ID from mailboxes --engine sqlite")
+    var mailboxRowid: Int64
+
+    @Option(name: .long, help: "Maximum messages; refuse a scan that reaches this value")
+    var limit: Int = 50000
+
+    func run() async throws {
+        let config = pimOptions.loadConfig()
+        try checkMailEnabled(config: config)
+        guard mailboxRowid > 0 && limit > 1 else {
+            throw CLIError.invalidInput("Invalid mailbox row ID or limit")
+        }
+        let sqlite = try SQLiteEngine()
+        let listing = try sqlite.messages(mailbox: "", account: nil,
+                                          mailboxRowID: mailboxRowid, limit: limit, filter: nil)
+        guard let summaries = listing["messages"] as? [[String: Any]], summaries.count < limit else {
+            throw CLIError.invalidInput("Mailbox export reached its limit")
+        }
+        try outputJSONLine(["type": "header", "mailboxRowid": mailboxRowid,
+                            "count": summaries.count,
+                            "totalInMailbox": listing["totalInMailbox"] ?? 0])
+        var missingBodies = 0
+        for summary in summaries {
+            guard let localId = summary["localId"] as? Int64, localId > 0 else {
+                throw CLIError.invalidInput("Message missing local ID")
+            }
+            do {
+                let result = try sqlite.get(localId: localId, includeSource: false)
+                guard let message = result["message"] as? [String: Any] else {
+                    throw CLIError.invalidInput("Message detail missing")
+                }
+                try outputJSONLine(["type": "message", "contentAvailable": true,
+                                    "message": message])
+            } catch EnvelopeIndexError.notAvailable {
+                missingBodies += 1
+                try outputJSONLine(["type": "message", "contentAvailable": false,
+                                    "message": summary])
+            }
+        }
+        try outputJSONLine(["type": "footer", "exported": summaries.count,
+                            "missingBodies": missingBodies])
+    }
+}
